<!--
  Eato - 自定义导航栏
  玻璃质感 + 返回按钮
-->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
  <view class="nav-bar-content" style="height: {{navBarHeight}}px">
    <!-- 左侧 -->
    <view class="nav-left">
      <block wx:if="{{showBack}}">
        <view class="nav-btn back-btn" bindtap="goBack">
          <image class="nav-icon" src="/assets/icons/arrow-left.svg" mode="aspectFit" />
        </view>
      </block>
      <slot name="left"></slot>
    </view>
    
    <!-- 标题 -->
    <view class="nav-title">
      <block wx:if="{{title}}">
        <text class="title-text">{{title}}</text>
      </block>
      <slot name="center"></slot>
    </view>
    
    <!-- 右侧 -->
    <view class="nav-right">
      <slot name="right"></slot>
    </view>
  </view>
</view>

<!-- 占位，防止内容被遮挡 -->
<view class="nav-bar-placeholder" style="height: {{statusBarHeight + navBarHeight}}px"></view>

