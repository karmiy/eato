/**
 * Eato - 玻璃卡片组件样式
 */

.glass-card {
  position: relative;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06),
              0 2rpx 8rpx rgba(255, 107, 157, 0.08);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 高光效果 */
.glass-highlight {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, 
    rgba(255, 255, 255, 0.6) 0%, 
    rgba(255, 255, 255, 0.2) 50%,
    transparent 100%
  );
  border-radius: 32rpx 32rpx 0 0;
  pointer-events: none;
}

.glass-content {
  position: relative;
  z-index: 1;
  padding: 32rpx;
}

/* 变体: 无内边距 */
.glass-card.no-padding .glass-content {
  padding: 0;
}

/* 变体: 小圆角 */
.glass-card.small-radius {
  border-radius: 20rpx;
}

.glass-card.small-radius .glass-highlight {
  border-radius: 20rpx 20rpx 0 0;
}

/* 变体: 浅色 */
.glass-card.light {
  background: rgba(255, 255, 255, 0.95);
}

/* 变体: 带边框高亮 */
.glass-card.bordered {
  border: 2rpx solid rgba(255, 107, 157, 0.2);
}

/* 变体: 无高光 */
.glass-card.no-highlight .glass-highlight {
  display: none;
}

