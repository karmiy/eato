/**
 * Eato - 菜单扫描页面样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #E8F4FF 0%, #FFF8FA 50%, #F8F4FF 100%);
}

.content {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* 图片区域 */
.images-section {
  margin-bottom: 32rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.images-scroll {
  white-space: nowrap;
}

.images-list {
  display: inline-flex;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-remove text {
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx dashed rgba(107, 91, 255, 0.3);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.image-add image {
  width: 48rpx;
  height: 48rpx;
}

.image-add text {
  font-size: 24rpx;
  color: #666680;
}

/* 设置区域 */
.settings-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.setting-card {
  padding: 0;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  width: 44rpx;
  height: 44rpx;
}

.setting-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A2E;
}

/* 人数选择器 */
.number-picker {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.picker-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.picker-btn.active {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}

.picker-btn image {
  width: 32rpx;
  height: 32rpx;
}

.picker-btn.active image {
  filter: brightness(0) invert(1);
}

.picker-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
  min-width: 60rpx;
  text-align: center;
}

/* 预算输入 */
.budget-input {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.budget-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF6B9D;
}

.budget-field {
  width: 160rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
  text-align: right;
}

/* 成员选择 */
.members-preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.members-text {
  font-size: 28rpx;
  color: #999AAA;
}

.member-avatars {
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
  border: 3rpx solid #fff;
}

.member-avatar:first-child {
  margin-left: 0;
}

.member-avatar text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.more-members {
  font-size: 24rpx;
  color: #666680;
  margin-left: 8rpx;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

/* 操作区域 */
.action-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.btn-gradient-large {
  width: 100%;
  background: linear-gradient(135deg, #6B5BFF 0%, #A89EFF 100%);
  border-radius: 48rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(107, 91, 255, 0.4);
  transition: all 0.3s ease;
}

.btn-gradient-large:active {
  transform: scale(0.98);
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.btn-content .btn-emoji {
  font-size: 40rpx;
}

.btn-content text {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.action-hint {
  font-size: 24rpx;
  color: #999AAA;
  margin-top: 24rpx;
  text-align: center;
}
