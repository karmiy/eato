/**
 * Eato - 菜单推荐结果页样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #E8F4FF 0%, #FFF8FA 50%, #F8F4FF 100%);
}

.content {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.bottom-bar-placeholder {
  height: calc(env(safe-area-inset-bottom) + 160rpx);
}

/* 方案标签 */
.scheme-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
}

.scheme-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.scheme-tab.active {
  background: rgba(255, 255, 255, 0.95);
  border-color: #6B5BFF;
  box-shadow: 0 4rpx 20rpx rgba(107, 91, 255, 0.2);
}

.tab-label {
  font-size: 26rpx;
  color: #666680;
  margin-bottom: 4rpx;
}

.scheme-tab.active .tab-label {
  color: #6B5BFF;
  font-weight: 600;
}

.tab-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
}

/* 概览卡片 */
.overview-card {
  margin-bottom: 24rpx;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.overview-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 8rpx;
  display: block;
}

.overview-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #666680;
  background: rgba(0, 0, 0, 0.04);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.overview-price {
  text-align: right;
}

.price-label {
  font-size: 24rpx;
  color: #999AAA;
  display: block;
}

.price-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B9D;
}

.ai-reason {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: rgba(107, 91, 255, 0.08);
  border-radius: 16rpx;
}

.ai-badge {
  background: linear-gradient(135deg, #6B5BFF 0%, #A89EFF 100%);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.ai-badge text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}

.reason-text {
  font-size: 26rpx;
  color: #666680;
  line-height: 1.6;
}

/* 菜品区域 */
.dishes-section {
  margin-top: 8rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.dishes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-card {
  padding: 0;
}

.dish-content {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  gap: 24rpx;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
  margin-bottom: 8rpx;
}

.dish-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.dish-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 107, 157, 0.15);
  color: #FF6B9D;
}

.dish-desc {
  font-size: 24rpx;
  color: #999AAA;
}

.dish-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.dish-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn.active {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
}

.qty-btn image {
  width: 28rpx;
  height: 28rpx;
}

.qty-btn.active image {
  filter: brightness(0) invert(1);
}

.qty-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  min-width: 40rpx;
  text-align: center;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.bar-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 28rpx;
  color: #666680;
}

.total-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B9D;
}

.bar-right {
  display: flex;
  gap: 16rpx;
}

.btn-secondary-small,
.btn-primary-small {
  padding: 20rpx 36rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-secondary-small {
  background: rgba(0, 0, 0, 0.04);
  color: #666680;
}

.btn-primary-small {
  background: linear-gradient(135deg, #6B5BFF 0%, #A89EFF 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(107, 91, 255, 0.3);
}
