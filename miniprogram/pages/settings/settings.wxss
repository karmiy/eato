/**
 * Eato - 设置页面样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F7 50%, #F8F4FF 100%);
}

.content {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 60rpx);
  flex-shrink: 0;
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #666680;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.settings-card {
  padding: 0;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item.clickable {
  transition: background 0.2s ease;
}

.setting-item.clickable:active {
  background: rgba(0, 0, 0, 0.02);
}

.setting-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #1A1A2E;
}

.setting-value {
  font-size: 26rpx;
  color: #999AAA;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
}

/* 滑块 */
.setting-slider {
  width: 200rpx;
}

/* Switch 样式调整 */
switch {
  transform: scale(0.8);
}

