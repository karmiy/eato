/**
 * Eato - 推荐结果页样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F7 50%, #F8F4FF 100%);
}

.content {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* 餐厅卡片 */
.restaurant-card {
  margin-bottom: 32rpx;
  overflow: hidden;
}

.restaurant-image {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
  border-radius: 32rpx 32rpx 0 0;
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.3) 100%);
}

.favorite-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.favorite-btn image {
  width: 36rpx;
  height: 36rpx;
}

.favorite-btn.active {
  background: #FF6B9D;
}

.favorite-btn.active image {
  filter: brightness(0) invert(1);
}

/* 餐厅信息 */
.restaurant-info {
  padding: 32rpx;
}

.restaurant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.restaurant-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.rating-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FFB800 0%, #FFC700 100%);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.star-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.rating-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.restaurant-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666680;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
}

.meta-divider {
  width: 2rpx;
  height: 24rpx;
  background: #E5E5EA;
}

.price-text {
  color: #FF6B9D;
  font-weight: 600;
}

.restaurant-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-tag.open {
  background: rgba(52, 199, 89, 0.15);
  color: #34C759;
}

.status-tag.closed {
  background: rgba(255, 59, 48, 0.15);
  color: #FF3B30;
}

.business-hours {
  font-size: 24rpx;
  color: #999AAA;
}

/* AI 推荐理由 */
.reason-card {
  margin-bottom: 40rpx;
}

.reason-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ai-badge {
  background: linear-gradient(135deg, #6B5BFF 0%, #A89EFF 100%);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.ai-badge text {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.reason-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.reason-text {
  font-size: 28rpx;
  color: #666680;
  line-height: 1.7;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.btn-secondary-custom,
.btn-primary-custom {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-secondary-custom {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  color: #666680;
  border: 2rpx solid rgba(255, 107, 157, 0.2);
}

.btn-primary-custom {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.4);
}

.btn-emoji {
  font-size: 32rpx;
  flex-shrink: 0;
}

.blacklist-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.btn-secondary-custom:active,
.btn-primary-custom:active {
  transform: scale(0.98);
}

/* 黑名单操作 */
.blacklist-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
}

.blacklist-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.blacklist-action text {
  font-size: 26rpx;
  color: #999AAA;
}

