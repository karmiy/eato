/**
 * Eato - 成员编辑页面样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F7 50%, #F8F4FF 100%);
}

.content {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 200rpx);
}

/* 头像区域 */
.profile-card {
  margin-bottom: 32rpx;
}

.profile-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.3);
}

.avatar-picker text {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}

.name-input-wrapper {
  width: 100%;
  max-width: 400rpx;
}

.name-input {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A2E;
  padding: 16rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 16rpx;
}

/* 区块 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.options-card,
.budget-card {
  padding: 24rpx 28rpx;
}

/* 选项组 */
.option-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.option-label {
  font-size: 28rpx;
  color: #666680;
}

.option-items {
  display: flex;
  gap: 12rpx;
}

.option-item {
  padding: 16rpx 28rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.option-item.active {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}

.option-item text {
  font-size: 26rpx;
  color: #666680;
}

.option-item.active text {
  color: #fff;
  font-weight: 500;
}

/* 标签组 */
.tags-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 14rpx 24rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.tag-item.active {
  background: rgba(255, 107, 157, 0.15);
  border-color: #FF6B9D;
}

.tag-item text {
  font-size: 26rpx;
  color: #666680;
}

.tag-item.active text {
  color: #FF6B9D;
  font-weight: 500;
}

.tag-item.warning.active {
  background: rgba(255, 59, 48, 0.15);
  border-color: #FF3B30;
}

.tag-item.warning.active text {
  color: #FF3B30;
}

/* 预算输入 */
.budget-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.budget-input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.04);
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.budget-symbol {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF6B9D;
}

.budget-input input {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A2E;
}

.budget-separator {
  font-size: 30rpx;
  color: #999AAA;
}

/* 保存区域 */
.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
}

.btn-save {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.3);
  box-sizing: border-box;
}

.btn-save text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.btn-delete {
  width: 100%;
  padding: 16rpx;
  text-align: center;
  box-sizing: border-box;
}

.btn-delete text {
  font-size: 28rpx;
  color: #FF3B30;
}
