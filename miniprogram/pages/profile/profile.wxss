/**
 * Eato - 我的页面样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F7 50%, #F8F4FF 100%);
}

/* 固定顶部背景 */
.header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #FFE5EC;
}

/* 可滚动内容 */
.scroll-content {
  flex: 1;
}

/* 顶部占位（由 JS 动态设置） */
.header-placeholder {
}

/* 顶部区域 */
.header-section {
  padding: 16rpx 32rpx 24rpx;
}

/* TabBar 占位 */
.tab-bar-placeholder {
  height: calc(env(safe-area-inset-bottom) + 130rpx);
}

.user-card {
  padding: 0;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
}

.avatar-wrapper {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.2);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}

.avatar-edit image {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}

.user-detail {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.user-slogan {
  display: block;
  font-size: 26rpx;
  color: #666680;
}

/* 统计数据 */
.user-stats {
  display: flex;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.stat-label {
  font-size: 24rpx;
  color: #999AAA;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.08);
  align-self: center;
}

/* 功能列表 */
.menu-section {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-card {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon.pink {
  background: linear-gradient(135deg, rgba(255, 107, 157, 0.15) 0%, rgba(255, 158, 196, 0.1) 100%);
}

.menu-icon.purple {
  background: linear-gradient(135deg, rgba(107, 91, 255, 0.15) 0%, rgba(168, 158, 255, 0.1) 100%);
}

.menu-icon.red {
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.15) 0%, rgba(255, 107, 107, 0.1) 100%);
}

.menu-icon.gray {
  background: linear-gradient(135deg, rgba(153, 154, 170, 0.15) 0%, rgba(200, 200, 210, 0.1) 100%);
}

.menu-icon image {
  width: 36rpx;
  height: 36rpx;
}

.menu-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.menu-desc {
  font-size: 24rpx;
  color: #999AAA;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}
