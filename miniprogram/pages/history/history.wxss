/**
 * Eato - 用餐记录页面样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F7 50%, #F8F4FF 100%);
}

.content {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* 日期分组 */
.date-group {
  margin-bottom: 32rpx;
}

.date-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #666680;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.records {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-card {
  padding: 0;
}

.record-content {
  padding: 24rpx 28rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.record-time {
  font-size: 24rpx;
  color: #999AAA;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-item image {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.meta-item text {
  font-size: 24rpx;
  color: #666680;
}

.rating-stars {
  display: flex;
  gap: 4rpx;
}

.rating-stars image {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.3;
}

.rating-stars image.active {
  opacity: 1;
}

.record-dishes {
  font-size: 24rpx;
  color: #999AAA;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: rgba(107, 91, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon image {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999AAA;
  text-align: center;
}

