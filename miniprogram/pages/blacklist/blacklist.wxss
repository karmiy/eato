/**
 * Eato - 黑名单页面样式
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFF5F7 50%, #F8F4FF 100%);
}

.content {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* 提示栏 */
.tip-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 149, 0, 0.1);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.tip-bar image {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}

.tip-bar text {
  font-size: 24rpx;
  color: #FF9500;
}

/* 餐厅列表 */
.restaurant-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.restaurant-card {
  padding: 0;
}

.restaurant-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.restaurant-info {
  flex: 1;
}

.restaurant-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.restaurant-reason {
  font-size: 24rpx;
  color: #999AAA;
}

.remove-btn {
  padding: 16rpx 28rpx;
  background: rgba(255, 59, 48, 0.1);
  border-radius: 16rpx;
}

.remove-btn text {
  font-size: 26rpx;
  color: #FF3B30;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: rgba(153, 154, 170, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon image {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999AAA;
  text-align: center;
}

