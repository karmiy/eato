/**
 * Eato - 全局样式
 * 设计风格：高级感 + 高光泽玻璃质感 + 柔和渐变
 */

/* CSS Variables */
page {
  --primary: #FF6B9D;
  --primary-light: #FFB3CC;
  --primary-dark: #E5547F;
  --secondary: #FF9EC4;
  --accent: #6B5BFF;
  --accent-light: #A89EFF;
  
  /* 渐变色 */
  --gradient-pink: linear-gradient(135deg, #FFE5EC 0%, #FFF5F7 50%, #F0E6FF 100%);
  --gradient-button: linear-gradient(135deg, #FF6B9D 0%, #FF9EC4 100%);
  --gradient-card: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
  --gradient-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.4) 100%);
  
  /* 背景色 */
  --bg-primary: #FFF5F7;
  --bg-secondary: #FFFFFF;
  --bg-glass: rgba(255, 255, 255, 0.7);
  
  /* 文字颜色 */
  --text-primary: #1A1A2E;
  --text-secondary: #666680;
  --text-muted: #999AAA;
  --text-white: #FFFFFF;
  
  /* 边框和阴影 */
  --border-light: rgba(255, 107, 157, 0.2);
  --shadow-sm: 0 2rpx 8rpx rgba(255, 107, 157, 0.1);
  --shadow-md: 0 8rpx 24rpx rgba(255, 107, 157, 0.15);
  --shadow-lg: 0 16rpx 48rpx rgba(255, 107, 157, 0.2);
  --shadow-glass: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  
  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;

  /* 布局尺寸 */
  --tabbar-height: 120rpx;  /* 自定义 TabBar 高度 */
  --safe-bottom: env(safe-area-inset-bottom);

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-full: 9999rpx;
  
  /* 页面基础样式 */
  background: var(--gradient-pink);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* 玻璃卡片 */
.glass-card {
  background: var(--gradient-glass);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: var(--shadow-glass);
}

/* 渐变按钮 */
.btn-gradient {
  background: var(--gradient-button);
  color: var(--text-white);
  border: none;
  border-radius: var(--radius-full);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
}

.btn-gradient:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 次要按钮 */
.btn-secondary {
  background: var(--bg-glass);
  backdrop-filter: blur(10rpx);
  color: var(--primary);
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-full);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 圆形图标按钮 */
.btn-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-glass);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.btn-icon:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.9);
}

/* 安全区域 */
.safe-area-top {
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  height: calc(env(safe-area-inset-bottom) + 110rpx);
}

/* TabBar 页面底部占位 - 用于有 TabBar 的页面 */
.tab-bar-placeholder {
  height: calc(env(safe-area-inset-bottom) + 110rpx);
  width: 100%;
}

/* 导航栏占位 - 用于固定导航栏下方的内容 */
.nav-bar-spacing {
  width: 100%;
}

/* 文字样式 */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-accent { color: var(--primary); }

/* 字体大小 */
.text-xs { font-size: 22rpx; }
.text-sm { font-size: 26rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 44rpx; }
.text-3xl { font-size: 56rpx; }

/* 字重 */
.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

/* Flex 布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }
.gap-sm { gap: var(--space-sm); }
.gap-md { gap: var(--space-md); }
.gap-lg { gap: var(--space-lg); }

